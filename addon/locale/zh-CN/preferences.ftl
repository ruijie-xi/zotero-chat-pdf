pref-title = ChatPDF 设置
pref-section-models = 模型与已保存配置
pref-section-pdf = PDF 转换
pref-section-behavior = 聊天行为
pref-section-prompt = 系统提示词
pref-section-advanced = 高级：模型额度、存储与诊断
pref-vision-advanced = 高级转换设置
pref-save-hint = 设置即时生效；系统提示词需要点击“保存提示词”。
pref-profile-save-hint = 保存当前字段可更新具名配置。PDF 转换使用所选配置的已保存字段，不受当前聊天字段的修改影响。
pref-profile-save = 将当前字段保存为配置
pref-profile-placeholder =
    .placeholder = 配置名称
pref-prompt-default-en = 保存英文默认提示词
pref-prompt-default-zh = 保存中文默认提示词
pref-prompt-save = 保存提示词
pref-test-button = 测试 LLM
pref-limits-hint = 0 表示使用接口提供的额度。手动额度应保存到模型配置中；刷新会包含当前手动额度。
pref-generation-hint = 自动生成使用模型允许的最大输出量，包含思考。正数表示你为每次请求及重试设置的上限；插件会据此预留输入空间。
pref-pdf-vision-stream = 实时查看转换内容
pref-pdf-vision-stream-hint = 使用同一次请求显示正在生成的内容。若接口不支持流式响应，可关闭此项；普通 JSON 响应也可直接接收。
pref-mineru-token = MinerU API Token
pref-mineru-language = MinerU 文档语言
pref-mineru-timeout = MinerU 超时（分钟）
pref-llm-api-base = API 基础地址
pref-llm-provider = 模型服务
pref-llm-provider-custom =
    .label = 自定义（兼容 OpenAI）
pref-llm-model-suggestions =
    .label = 选择模型
    .aria-label = 建议的模型
pref-llm-provider-go-hint = 使用 OpenCode Go API Key，模型名称无需 opencode-go/ 前缀。DeepSeek V4 的本地 token 计数是估算值；接口可能拒绝 ChatPDF 请求。
pref-llm-api-key = API Key
pref-llm-model = 模型名称
pref-llm-thinking-mode = 思考模式
pref-llm-think-effort = 思考强度
pref-llm-test = LLM API 测试
pref-panel-width = 面板宽度（像素）
pref-cache-dir = 缓存目录
pref-debug-log-mode = 诊断日志内容
pref-debug-log-retention = 日志保留天数
pref-system-prompt = 系统提示词
pref-model-profiles = 已保存的模型配置
pref-profile-name = 配置名称
pref-agent-max-iterations = 关闭自动继续时的步骤上限
pref-agent-auto-continue = 自动继续直至完成（随时可停止）
pref-enable-web-tools = 启用网页搜索工具
pref-brave-search-api-key = Brave Search API Key（可选）
pref-context-window-tokens = 合并上下文窗口（token）
pref-input-token-limit = 独立输入上限（token，可选）
pref-max-output-tokens = 模型最大输出量（token）
pref-requested-output-tokens = 每次生成上限，包含思考（0 表示模型最大值）
pref-image-token-reserve = 每张图片预留量（0 表示自动）
pref-tokenizer-mode = 本地 token 计数方式
pref-model-limits-refresh = 刷新模型额度
pref-pdf-engine = PDF 转换方式
pref-pdf-engine-vision =
    .label = 视觉模型
pref-pdf-engine-mineru =
    .label = MinerU
pref-pdf-vision-profile = 转换模型配置
pref-pdf-vision-pages = 每次请求页数（1–10）
pref-pdf-vision-concurrency = 同时请求数量（1–4）
pref-pdf-vision-dpi = 页面图片分辨率（72–300 DPI）
pref-pdf-vision-images = 缓存页面图片，供查看与图片工具使用
pref-pdf-vision-timeout = 单次请求超时（秒）
pref-pdf-vision-self-check = 在同一次响应中进行模型自查
pref-pdf-vision-self-check-hint = 原模型只追加定点修改或空结果，无需另一次请求或重发页面图片。这能减少 token 开销，但属于原模型自查。已有缓存需重新识别才能使用。
pref-pdf-vision-hint = 选择已保存的视觉模型配置，或跟随当前聊天模型。页面图片将发送到该模型的接口；额度采用它的配置。已有缓存可继续使用。
pref-library-edit-mode = Agent 文献库修改
pref-library-edit-ask =
    .label = 每批修改先审阅
pref-library-edit-readonly =
    .label = 只读
pref-library-edit-selected =
    .label = 允许修改当前选中条目
pref-library-edit-collection =
    .label = 允许修改当前集合及子集合
pref-library-edit-library =
    .label = 允许修改当前文献库
pref-library-edit-hint = 文献库修改权限可在聊天窗口的消息输入框上方直接设置。
